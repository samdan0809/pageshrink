{
  "manifest_version": 3,
  "name": "PageShrink 页面小窗",
  "version": "2.1.1",
  "description": "点击工具栏图标，把当前页面搬进一个无边框的小窗口；鼠标离开小窗时用白色或自定义图片盖住网页，移回即恢复。",

  "permissions": ["storage", "activeTab", "scripting"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "PageShrink：点击把页面收进小窗",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
